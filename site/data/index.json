  "persons": [
    {
      "qid": "guji-曹沫",
      "name_zh": "曹沫",
      "era": "春秋初期",
      "archetype": "以勇夺城的义士",
      "role": "模范",
      "birth_date": "约-720",
      "death_date": "不详",
      "summary_first_person": "吾三战三败，失地千里，天下笑吾为败军之将。然吾知勇者不以一败而丧志。柯之盟上，吾以一匕首劫齐桓公于坛上，使归我汶阳之田。管仲纵有万般计谋，亦不敢赌桓公之命。",
      "century": "bce0800",
      "events_count": 3,
      "highlights_count": 1
    },
    {
      "qid": "Q4604",
      "name_zh": "孔子",
      "era": "春秋",
      "archetype": "奠基型",
      "role": "模范",
      "birth_date": "-551-09-28",
      "death_date": "-479-04-11",
      "summary_first_person": "我周游列国而不得用，归而修诗书——若道不行，便让它在后世行。",
      "century": "bce0600",
      "events_count": 5,
      "highlights_count": 0
    },
    {
      "qid": "guji-孙武",
      "name_zh": "孙武",
      "era": "春秋末期",
      "archetype": "以道驭术的兵家宗师",
      "role": "模范",
      "birth_date": "约-545",
      "death_date": "约-470",
      "summary_first_person": "吾本齐国之后，见齐政日乱，携一卷兵书南奔吴国。阖闾用吾之策，五战五胜，直入郢都。然吴宫之后，世间再无孙武用兵之迹，唯余十三篇兵法，任后人评说。",
      "century": "bce0600",
      "events_count": 6,
      "highlights_count": 3
    },
    {
      "qid": "guji-专诸",
      "name_zh": "专诸",
      "era": "春秋末期",
      "archetype": "一击必杀的义士",
      "role": "模范",
      "birth_date": "约-537",
      "death_date": "-515",
      "summary_first_person": "吾有老母在堂，未敢以身许人。母既终，吾乃无后顾之忧。公子光待吾以国士，吾当以国士报之。鱼藏剑中，一击而中王僚之心，吾虽死无憾。",
      "century": "bce0600",
      "events_count": 4,
      "highlights_count": 2
    },
    {
      "qid": "guji-句践",
      "name_zh": "句践",
      "era": "春秋末期",
      "archetype": "卧薪尝胆的复仇之王",
      "role": "模范",
      "birth_date": "约-520",
      "death_date": "-465",
      "summary_first_person": "吾会稽兵败，为吴王夫差驾车三年，尝粪问疾始得归越。卧薪尝胆二十年，十年生聚十年教训，终灭吴国。吾能忍天下人所不能忍，故能成天下人所不能成。然范蠡知吾，文种不知，终成悲剧。",
      "century": "bce0600",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "Q913",
      "name_zh": "苏格拉底",
      "era": "古希腊",
      "archetype": "诘问型",
      "role": "模范",
      "birth_date": "-470-01-01",
      "death_date": "-399-01-01",
      "summary_first_person": "我自知无知——在不断的追问里，人才能靠近真实的自己。",
      "century": "bce0500",
      "events_count": 3,
      "highlights_count": 1
    },
    {
      "qid": "guji-豫让",
      "name_zh": "豫让",
      "era": "战国初期",
      "archetype": "士为知己者死的终极诠释",
      "role": "模范",
      "birth_date": "约-470",
      "death_date": "-453",
      "summary_first_person": "吾事范氏、中行氏，彼以众人遇吾，吾以众人报之。智伯以国士遇吾，吾以国士报之。智伯已死，吾漆身吞炭，虽肝脑涂地亦不悔。'士为知己者死，女为悦己者容'——此吾之志也。",
      "century": "bce0500",
      "events_count": 5,
      "highlights_count": 3
    },
    {
      "qid": "guji-吴起",
      "name_zh": "吴起",
      "era": "战国初期",
      "archetype": "以血铸剑的变法名将",
      "role": "模范",
      "birth_date": "约-440",
      "death_date": "-381",
      "summary_first_person": "吾少时散尽千金以求仕途，母丧不归，曾子绝之。吾杀妻以取信鲁君，世人皆谓吾不仁。然吾在魏守河西二十年，秦人不敢东向；在楚变法诸侯皆惧。死于乱箭之下，方知变法者终难逃一劫。",
      "century": "bce0500",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "guji-荆轲",
      "name_zh": "荆轲",
      "era": "战国末期",
      "archetype": "易水悲歌的千古刺客",
      "role": "模范",
      "birth_date": "约-424",
      "death_date": "-227",
      "summary_first_person": "风萧萧兮易水寒，壮士一去兮不复还。吾知此去必死，然天下苦秦久矣。太子丹以国士待吾，吾当以国士报之。图穷匕见之际，吾距秦王不过数步，然天命不在吾。倚柱而笑，箕踞而骂，吾虽身死，刺秦之志千秋不灭。",
      "century": "bce0500",
      "events_count": 6,
      "highlights_count": 3
    },
    {
      "qid": "guji-聂政",
      "name_zh": "聂政",
      "era": "战国初期",
      "archetype": "以身报恩的死士",
      "role": "模范",
      "birth_date": "约-410",
      "death_date": "-397",
      "summary_first_person": "严仲子不远千里结交于吾，吾母在堂未敢以身相许。母既终，吾遂许之。一人仗剑入韩，上阶刺杀侠累，左右大乱。吾恐连累家人，自毁面目，剖腹而死。吾姊来认吾尸，使吾之名不至湮灭。",
      "century": "bce0500",
      "events_count": 4,
      "highlights_count": 2
    },
    {
      "qid": "guji-商鞅",
      "name_zh": "商鞅",
      "era": "战国中期",
      "archetype": "以法治国的铁血改革者",
      "role": "模范",
      "birth_date": "约-390",
      "death_date": "-338",
      "summary_first_person": "吾三说秦孝公，以帝道、王道、霸道试之，孝公终用霸道。吾废井田、开阡陌、立军功，使秦人勇于公战。然吾终死于自己所立之法——太子犯法，吾刑其师傅；孝公死后，太子即位，吾遂车裂而亡。法在而人亡，此吾之宿命也。",
      "century": "bce0400",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "guji-孙膑",
      "name_zh": "孙膑",
      "era": "战国中期",
      "archetype": "以弱胜强的军师智者",
      "role": "模范",
      "birth_date": "约-380",
      "death_date": "约-316",
      "summary_first_person": "吾与庞涓同师鬼谷子，本以为手足之情可期终身。不料其嫉吾之才，诱我至魏而施以膑刑。吾装疯避祸，终得归齐。马陵道上万弩齐发之时，庞涓方知'孙膑在此'四字的分量。",
      "century": "bce0400",
      "events_count": 6,
      "highlights_count": 4
    },
    {
      "qid": "guji-屈原",
      "name_zh": "屈原",
      "era": "战国中后期",
      "archetype": "以身殉道的诗人政客",
      "role": "模范",
      "birth_date": "约-340",
      "death_date": "-278",
      "summary_first_person": "吾以王族之血，怀美政之志，入则与王议国事，出则号令遇宾客。奈何上官大夫妒之，令尹子兰毁之，王终疏吾。吾行吟泽畔，颜色憔悴，渔父问曰'何故至于斯'，吾曰'举世皆浊我独清'。郢都既破，吾遂自沉汨罗。",
      "century": "bce0400",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "Q162427",
      "name_zh": "秦始皇",
      "era": "战国末/秦",
      "archetype": "统合型",
      "role": "教训",
      "birth_date": "-259-02-18",
      "death_date": "-210-07-10",
      "summary_first_person": "我以铁与法把六国压成一块版图，却忘了版图需要人心来粘合。",
      "century": "bce0300",
      "events_count": 5,
      "highlights_count": 0
    },
    {
      "qid": "guji-萧何",
      "name_zh": "萧何",
      "era": "秦末汉初",
      "archetype": "以文治定天下的汉家第一相",
      "role": "模范",
      "birth_date": "约-257",
      "death_date": "-193",
      "summary_first_person": "吾本沛县一吏，日日案牍劳形，人皆以为庸碌。然吾观天下大势，知秦必亡、民思乱久矣。刘季过沛，吾知其非常人，遂以身相许。入咸阳时，诸将争金帛，吾独取秦丞相府图籍文书，天下户口强弱尽在胸中。此后镇守关中，转漕关东，粮饷不绝于道，终助高祖定鼎天下。论功行赏，吾居第一，然吾深知，刀笔吏之功不在沙场，在于让天下有序。",
      "century": "bce0300",
      "events_count": 9,
      "highlights_count": 6
    },
    {
      "qid": "guji-陈平",
      "name_zh": "陈平",
      "era": "秦末汉初",
      "archetype": "以奇谋诡道纵横乱世的智囊",
      "role": "模范",
      "birth_date": "约-257",
      "death_date": "-178",
      "summary_first_person": "吾少时贫，人皆笑之。乡里富人张负以女妻之，曰：'人固有好美如陈平而长贫贱者乎？'吾游学四方，事魏王咎不用，事项王又不见用。至汉，高祖用吾为护军中尉。吾一生所学，不在仁义，在于权变。离间项范、擒缚韩信、解围白登，六出奇计，世人或以诡道目之，然乱世之中，正道不能存身，唯奇谋可活万民。",
      "century": "bce0300",
      "events_count": 9,
      "highlights_count": 6
    },
    {
      "qid": "guji-刘邦",
      "name_zh": "刘邦",
      "era": "秦末汉初",
      "archetype": "无赖天子，布衣帝王",
      "role": "模范",
      "birth_date": "-256",
      "death_date": "-195",
      "summary_first_person": "吾本泗水亭长，好酒好色，人皆以为无赖。然观秦皇帝出行，叹曰'大丈夫当如此也'。斩白蛇起事，约法三章入关中，鸿门宴全身而退，五年楚汉终有天下。论运筹帷幄吾不如子房，论治国抚民吾不如萧何，论战必胜攻必取吾不如韩信——然此三者皆人杰，吾能用之，此吾所以取天下也。",
      "century": "bce0300",
      "events_count": 10,
      "highlights_count": 8
    },
    {
      "qid": "guji-周勃",
      "name_zh": "周勃",
      "era": "秦末汉初",
      "archetype": "以忠勇定社稷的绛侯",
      "role": "模范",
      "birth_date": "约-250",
      "death_date": "-169",
      "summary_first_person": "吾本沛县贫民，以织蚕箔为生，又兼为人吹箫给丧事。高祖起沛，吾以中涓从之，每战先登，攻城拔旗，身被七十余创。天下既定封绛侯。吕后时，诸吕擅权，吾握兵权而隐忍不发。吕后崩，吾一呼而北军左袒，诛灭诸吕，安刘氏社稷。然功高见疑，文帝几杀吾于狱中。人谓吾勇，吾知忠比勇更难。",
      "century": "bce0300",
      "events_count": 9,
      "highlights_count": 3
    },
    {
      "qid": "guji-张良",
      "name_zh": "张良",
      "era": "秦末汉初",
      "archetype": "以智谋定天下的谋圣",
      "role": "模范",
      "birth_date": "约-250",
      "death_date": "-186",
      "summary_first_person": "吾本韩相之后，韩亡于秦，吾恨之入骨。博浪沙一击，虽不中秦皇帝，然天下知有张良一人。后于下邳圯上得黄石公兵书，读之十年，胸中自有天下经纬。沛公用吾之策，入咸阳、还定三秦、鸿门宴脱险、下邑之谋定天下大计，垓下一战灭项王。功成之后，吾辞封万户侯而请封留，从赤松子游，辟谷学道。人皆以为奇，吾知帝王之侧非久居之地也。",
      "century": "bce0300",
      "events_count": 9,
      "highlights_count": 7
    },
    {
      "qid": "guji-吕后",
      "name_zh": "吕后",
      "era": "汉初",
      "archetype": "刚毅决断的铁腕女主",
      "role": "模范",
      "birth_date": "约-241",
      "death_date": "-180",
      "summary_first_person": "吾随高祖于微时，备尝艰辛。天下既定，戚夫人日夜啼泣欲夺吾儿太子之位，几废几立。高祖崩后，吾称制天下。人皆谓吾残忍，然吾若不刚毅，刘氏天下何以安？吕氏何以存？吾身后诸吕皆诛，然惠文之世天下太平，岂非吾之功耶？",
      "century": "bce0300",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "guji-冒顿",
      "name_zh": "冒顿",
      "era": "秦末汉初",
      "archetype": "以铁血重塑草原秩序的草原雄主",
      "role": "模范",
      "birth_date": "约-234",
      "death_date": "约-174",
      "summary_first_person": "吾少时质于月氏，受尽屈辱。父欲废吾而立幼子，吾乃作鸣镝，令骑射皆随鸣镝所向。先射吾爱马，左右不敢从者斩之；再射吾爱妾，左右复不敢者又斩之。至猎时，吾鸣镝射父之良马，左右皆随射之——于是吾知，鸣镝所向，众必随之。遂弑父自立，东灭东胡，西逐月氏，控弦之士三十万，草原尽归一统。",
      "century": "bce0300",
      "events_count": 7,
      "highlights_count": 4
    },
    {
      "qid": "guji-项羽",
      "name_zh": "项羽",
      "era": "秦末楚汉",
      "archetype": "力拔山兮的末路霸王",
      "role": "模范",
      "birth_date": "-232",
      "death_date": "-202",
      "summary_first_person": "吾起兵时二十四，八千子弟渡江而西，所当者破，所击者服，未尝一败。钜鹿破釜沉舟，诸侯壁上而观；鸿门纵虎归山，至今悔之。天亡我也，非战之罪——吾至死不悟，亦至死不悔。力拔山兮气盖世，时不利兮骓不逝。虞兮虞兮柰若何！",
      "century": "bce0300",
      "events_count": 12,
      "highlights_count": 10
    },
    {
      "qid": "guji-韩信",
      "name_zh": "韩信",
      "era": "秦末汉初",
      "archetype": "以兵法定天下却不知自保的兵仙",
      "role": "模范",
      "birth_date": "约-231",
      "death_date": "-196",
      "summary_first_person": "吾少时贫，寄食于漂母，母亦不厌。南昌亭长之妻不为吾具食，吾从之食数十日。淮阴屠中少年辱吾，令吾出胯下，吾孰视之，俯出胯下。天下皆以为怯，独吾知忍。后投汉王，登坛拜将，定三秦、灭赵、降燕、下齐，垓下围项王，天下无敌。然吾终不能自保，长乐宫中钟室之死，不知吾所学兵法，何以不能救吾一命。",
      "century": "bce0300",
      "events_count": 9,
      "highlights_count": 7
    },
    {
      "qid": "guji-汉文帝",
      "name_zh": "汉文帝",
      "era": "西汉",
      "archetype": "以德化民的仁圣之君",
      "role": "模范",
      "birth_date": "-203",
      "death_date": "-157",
      "summary_first_person": "朕本代王，居边鄙之地，不意大臣迎立。即位之初，诸吕新灭，人心未安。朕约法省禁，废肉刑，除诽谤，劝农桑，轻徭役。欲作露台，计直百金，中民十家之产也，遂不作。衣绨衣，帏帐不文绣，以示敦朴为天下先。匈奴入寇，朕不欲烦苦百姓深入追击，但令边备守而已。二十三年崩，遗令薄葬，天下闻之皆哀。",
      "century": "bce0300",
      "events_count": 8,
      "highlights_count": 6
    },
    {
      "qid": "guji-汉景帝",
      "name_zh": "汉景帝",
      "era": "西汉",
      "archetype": "守成之主与削藩推手",
      "role": "模范",
      "birth_date": "-188",
      "death_date": "-141",
      "summary_first_person": "朕承先帝之业，兢兢守成。晁错言诸侯太盛当削，朕从之，然七国俱反，以诛晁错为名。朕不得已诛晁错而兵不罢，乃用周亚夫三月平乱。诸侯自此衰，中央始固。然细柳之事，周亚夫刚直难用，终以冤死。文景之治，非朕之功，先帝遗德也。",
      "century": "bce0200",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "guji-董仲舒",
      "name_zh": "董仲舒",
      "era": "西汉武帝时期",
      "archetype": "以儒学改造帝国的思想建筑师",
      "role": "模范",
      "birth_date": "约-179",
      "death_date": "约-104",
      "summary_first_person": "吾少治《春秋》，下帷讲诵，弟子传以久次相受业，或莫见其面，盖三年不窥园。武帝即位，举贤良文学之士，吾以天人三策对之，言天人感应、大一统、独尊儒术。天子善之，遂罢黜百家，表章六经。然吾深知，以儒学定一尊，非吾之私意，乃天下大势所趋也。后吾为江都相，以《春秋》灾异之变推阴阳，终以论辽东高庙灾得罪，废为中大夫。然吾之学说，已成汉家法度，后世虽有损益，其大体不易。",
      "century": "bce0200",
      "events_count": 8,
      "highlights_count": 6
    },
    {
      "qid": "guji-汉武帝",
      "name_zh": "汉武帝",
      "era": "西汉",
      "archetype": "雄才大略的千古一帝",
      "role": "模范",
      "birth_date": "-156",
      "death_date": "-87",
      "summary_first_person": "朕十六岁即位，承文景之富，外有匈奴之患。朕北逐匈奴通西域，南灭百越东定朝鲜，四海之内莫不臣服。然朕一生好神仙之事，遣方士入海求蓬莱，封泰山祭泰一，虽屡为方士所欺而终不悟。巫蛊之祸，太子自缢，朕之大憾也。晚年悔之，下轮台罪己诏，然天下虚耗已不可复矣。",
      "century": "bce0200",
      "events_count": 9,
      "highlights_count": 7
    },
    {
      "qid": "guji-司马迁",
      "name_zh": "司马迁",
      "era": "西汉武帝时期",
      "archetype": "以血泪铸史的史家之圣",
      "role": "模范",
      "birth_date": "约-145",
      "death_date": "约-90",
      "summary_first_person": "吾父太史公临终执吾手而泣曰：'余死，汝必为太史。为太史，无忘吾所欲论著矣。'吾泣而受命。后遭李陵之祸，受腐刑之辱，肠一日而九回。每念斯耻，汗未尝不发背沾衣。然吾思之：'人固有一死，或重于泰山，或轻于鸿毛。'遂隐忍苟活，卒述往事，成一家之言。百三十篇既成，藏之名山，传之其人。此书上起黄帝，下至太初，凡三千余年，天人之际，古今之变，皆在其中。吾之血泪，唯此书可证。",
      "century": "bce0200",
      "events_count": 8,
      "highlights_count": 6
    },
