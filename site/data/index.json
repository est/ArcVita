  "persons": [
    {
      "qid": "guji-曹沫",
      "name_zh": "曹沫",
      "era": "春秋初期",
      "archetype": "以勇夺城的义士",
      "role": "模范",
      "birth_date": "约-720",
      "death_date": "不详",
      "summary_first_person": "吾三战三败，失地千里，天下笑吾为败军之将。然吾知勇者不以一败而丧志。柯之盟上，吾以一匕首劫齐桓公于坛上，使归我汶阳之田。管仲纵有万般计谋，亦不敢赌桓公之命。",
      "century": "bce0800",
      "events_count": 3,
      "highlights_count": 1
    },
    {
      "qid": "Q4604",
      "name_zh": "孔子",
      "era": "春秋",
      "archetype": "奠基型",
      "role": "模范",
      "birth_date": "-551-09-28",
      "death_date": "-479-04-11",
      "summary_first_person": "我周游列国而不得用，归而修诗书——若道不行，便让它在后世行。",
      "century": "bce0600",
      "events_count": 5,
      "highlights_count": 0
    },
    {
      "qid": "guji-孙武",
      "name_zh": "孙武",
      "era": "春秋末期",
      "archetype": "以道驭术的兵家宗师",
      "role": "模范",
      "birth_date": "约-545",
      "death_date": "约-470",
      "summary_first_person": "吾本齐国之后，见齐政日乱，携一卷兵书南奔吴国。阖闾用吾之策，五战五胜，直入郢都。然吴宫之后，世间再无孙武用兵之迹，唯余十三篇兵法，任后人评说。",
      "century": "bce0600",
      "events_count": 6,
      "highlights_count": 3
    },
    {
      "qid": "guji-专诸",
      "name_zh": "专诸",
      "era": "春秋末期",
      "archetype": "一击必杀的义士",
      "role": "模范",
      "birth_date": "约-537",
      "death_date": "-515",
      "summary_first_person": "吾有老母在堂，未敢以身许人。母既终，吾乃无后顾之忧。公子光待吾以国士，吾当以国士报之。鱼藏剑中，一击而中王僚之心，吾虽死无憾。",
      "century": "bce0600",
      "events_count": 4,
      "highlights_count": 2
    },
    {
      "qid": "guji-句践",
      "name_zh": "句践",
      "era": "春秋末期",
      "archetype": "卧薪尝胆的复仇之王",
      "role": "模范",
      "birth_date": "约-520",
      "death_date": "-465",
      "summary_first_person": "吾会稽兵败，为吴王夫差驾车三年，尝粪问疾始得归越。卧薪尝胆二十年，十年生聚十年教训，终灭吴国。吾能忍天下人所不能忍，故能成天下人所不能成。然范蠡知吾，文种不知，终成悲剧。",
      "century": "bce0600",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "Q913",
      "name_zh": "苏格拉底",
      "era": "古希腊",
      "archetype": "诘问型",
      "role": "模范",
      "birth_date": "-470-01-01",
      "death_date": "-399-01-01",
      "summary_first_person": "我自知无知——在不断的追问里，人才能靠近真实的自己。",
      "century": "bce0500",
      "events_count": 3,
      "highlights_count": 1
    },
    {
      "qid": "guji-豫让",
      "name_zh": "豫让",
      "era": "战国初期",
      "archetype": "士为知己者死的终极诠释",
      "role": "模范",
      "birth_date": "约-470",
      "death_date": "-453",
      "summary_first_person": "吾事范氏、中行氏，彼以众人遇吾，吾以众人报之。智伯以国士遇吾，吾以国士报之。智伯已死，吾漆身吞炭，虽肝脑涂地亦不悔。'士为知己者死，女为悦己者容'——此吾之志也。",
      "century": "bce0500",
      "events_count": 5,
      "highlights_count": 3
    },
    {
      "qid": "guji-吴起",
      "name_zh": "吴起",
      "era": "战国初期",
      "archetype": "以血铸剑的变法名将",
      "role": "模范",
      "birth_date": "约-440",
      "death_date": "-381",
      "summary_first_person": "吾少时散尽千金以求仕途，母丧不归，曾子绝之。吾杀妻以取信鲁君，世人皆谓吾不仁。然吾在魏守河西二十年，秦人不敢东向；在楚变法诸侯皆惧。死于乱箭之下，方知变法者终难逃一劫。",
      "century": "bce0500",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "guji-荆轲",
      "name_zh": "荆轲",
      "era": "战国末期",
      "archetype": "易水悲歌的千古刺客",
      "role": "模范",
      "birth_date": "约-424",
      "death_date": "-227",
      "summary_first_person": "风萧萧兮易水寒，壮士一去兮不复还。吾知此去必死，然天下苦秦久矣。太子丹以国士待吾，吾当以国士报之。图穷匕见之际，吾距秦王不过数步，然天命不在吾。倚柱而笑，箕踞而骂，吾虽身死，刺秦之志千秋不灭。",
      "century": "bce0500",
      "events_count": 6,
      "highlights_count": 3
    },
    {
      "qid": "guji-聂政",
      "name_zh": "聂政",
      "era": "战国初期",
      "archetype": "以身报恩的死士",
      "role": "模范",
      "birth_date": "约-410",
      "death_date": "-397",
      "summary_first_person": "严仲子不远千里结交于吾，吾母在堂未敢以身相许。母既终，吾遂许之。一人仗剑入韩，上阶刺杀侠累，左右大乱。吾恐连累家人，自毁面目，剖腹而死。吾姊来认吾尸，使吾之名不至湮灭。",
      "century": "bce0500",
      "events_count": 4,
      "highlights_count": 2
    },
    {
      "qid": "guji-商鞅",
      "name_zh": "商鞅",
      "era": "战国中期",
      "archetype": "以法治国的铁血改革者",
      "role": "模范",
      "birth_date": "约-390",
      "death_date": "-338",
      "summary_first_person": "吾三说秦孝公，以帝道、王道、霸道试之，孝公终用霸道。吾废井田、开阡陌、立军功，使秦人勇于公战。然吾终死于自己所立之法——太子犯法，吾刑其师傅；孝公死后，太子即位，吾遂车裂而亡。法在而人亡，此吾之宿命也。",
      "century": "bce0400",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "guji-孙膑",
      "name_zh": "孙膑",
      "era": "战国中期",
      "archetype": "以弱胜强的军师智者",
      "role": "模范",
      "birth_date": "约-380",
      "death_date": "约-316",
      "summary_first_person": "吾与庞涓同师鬼谷子，本以为手足之情可期终身。不料其嫉吾之才，诱我至魏而施以膑刑。吾装疯避祸，终得归齐。马陵道上万弩齐发之时，庞涓方知'孙膑在此'四字的分量。",
      "century": "bce0400",
      "events_count": 6,
      "highlights_count": 4
    },
    {
      "qid": "guji-屈原",
      "name_zh": "屈原",
      "era": "战国中后期",
      "archetype": "以身殉道的诗人政客",
      "role": "模范",
      "birth_date": "约-340",
      "death_date": "-278",
      "summary_first_person": "吾以王族之血，怀美政之志，入则与王议国事，出则号令遇宾客。奈何上官大夫妒之，令尹子兰毁之，王终疏吾。吾行吟泽畔，颜色憔悴，渔父问曰'何故至于斯'，吾曰'举世皆浊我独清'。郢都既破，吾遂自沉汨罗。",
      "century": "bce0400",
      "events_count": 7,
      "highlights_count": 5
    },
