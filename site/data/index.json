  "persons": [
    {
      "qid": "guji-禹",
      "name_zh": "禹",
      "era": "夏初",
      "archetype": "以水利定天下的上古圣王",
      "role": "模范",
      "birth_date": "约-2100",
      "death_date": "约-2029",
      "summary_first_person": "吾父鲧以堵治水，九年而败，殛于羽山。吾受命于危难，凿龙门、辟伊阙、通九河于海，十三年间三过家门而不敢入。洪水既平，吾定九州贡赋，铸九鼎以镇天下。舜禅位于吾，吾不敢忘，然吾子启贤，遂传位于启，自此天下为家，非吾所愿，乃时势使然。",
      "century": "bce2100",
      "events_count": 8,
      "highlights_count": 5
    },
    {
      "qid": "guji-汤",
      "name_zh": "汤",
      "era": "商初",
      "archetype": "顺天应人的开国明君",
      "role": "模范",
      "birth_date": "约-1650",
      "death_date": "约-1588",
      "summary_first_person": "吾起于西伯，知夏桀无道久矣。伊尹耕于有莘之野，吾三聘而得之。伊尹入夏观政，知桀必亡，乃归报吾。吾率诸侯自亳起兵，鸣条之战，夏师大败，桀走南巢。吾不欲杀桀，放之而已。天下诸侯推吾为天子，吾知此非力取，乃仁德所感也。",
      "century": "bce1700",
      "events_count": 9,
      "highlights_count": 5
    },
    {
      "qid": "guji-周武王",
      "name_zh": "周武王",
      "era": "西周初",
      "archetype": "吊民伐罪的革命之君",
      "role": "模范",
      "birth_date": "约-1080",
      "death_date": "约-1043",
      "summary_first_person": "吾父文王囚于羑里，吾知殷商气数已尽。文王既崩，吾继其遗志，东观兵于盟津，八百诸侯不期而会。后二年，纣杀比干、囚箕子，吾以为时不可失，遂率戎车三百乘、虎贲三千、甲士四万五千东征。牧野之战，殷师倒戈，纣自焚于鹿台。吾即天子位，封功臣于天下，建周家八百年基业。",
      "century": "bce1100",
      "events_count": 9,
      "highlights_count": 6
    },
    {
      "qid": "guji-周公旦",
      "name_zh": "周公旦",
      "era": "西周初",
      "archetype": "制礼作乐的圣人之师",
      "role": "模范",
      "birth_date": "约-1060",
      "death_date": "约-1036",
      "summary_first_person": "吾兄武王克殷而崩，成王年幼，天下未定。吾恐失天下之望，乃摄行政当国。管叔、蔡叔疑吾篡位，挟武庚叛。吾东征三年，诛管叔、杀武庚、降蔡叔，始定东方。又营洛邑为东都，制礼作乐，定宗法封建之制。七年而还政成王，吾未尝有不臣之心。后世或疑吾，然天知吾心。",
      "century": "bce1100",
      "events_count": 8,
      "highlights_count": 6
    },
    {
      "qid": "guji-周穆王",
      "name_zh": "周穆王",
      "era": "西周中期",
      "archetype": "远征四海的浪漫之君",
      "role": "模范",
      "birth_date": "约-1010",
      "death_date": "约-922",
      "summary_first_person": "吾承成康之治余荫，天下太平，遂欲穷天下之极。吾驾八骏之乘，率六师西征犬戎，获其五王，迁戎于太原。又西行至瑶池，会西王母于弇山之上，觞于瑶池之畔。吾游遍天下，东至东海，西极昆仑，南抵巴楚，北达朔漠。然远征耗国力，晚年王室渐衰，吾之壮游，究竟是开拓还是挥霍，后人自有评说。",
      "century": "bce1100",
      "events_count": 9,
      "highlights_count": 5
    },
    {
      "qid": "guji-周幽王",
      "name_zh": "周幽王",
      "era": "西周末",
      "archetype": "亡国之君的典型",
      "role": "模范",
      "birth_date": "约-800",
      "death_date": "前771",
      "summary_first_person": "吾得褒姒而大悦，废申后及太子宜臼，立褒姒为后、其子伯服为太子。褒姒不笑，吾燃烽火以逗之，诸侯至而无寇，褒姒乃大笑。申侯怒，引犬戎攻镐京。吾再燃烽火，诸侯不至。犬戎杀吾于骊山之下，掳褒姒而去。西周三百基业，毁于吾手。吾之罪，在于以私情废公义，以儿戏废信义。",
      "century": "bce0800",
      "events_count": 8,
      "highlights_count": 6
    },
    {
      "qid": "guji-管仲",
      "name_zh": "管仲",
      "era": "春秋",
      "archetype": "华夏第一相的治国宗师",
      "role": "模范",
      "birth_date": "约-723",
      "death_date": "前645",
      "summary_first_person": "吾少时贫困，鲍叔牙知吾才。公子纠争位败死，吾为阶下囚。鲍叔牙力荐吾为齐相，桓公不记一箭之仇用吾。吾相齐四十年，通货积财、轻重九府、相地而衰征，齐国大富。九合诸侯，一匡天下，非吾之力，乃用众人之力也。吾临终告桓公远竖刁、易牙、开方，桓公不听，果乱。吾生平最知者，知己如鲍叔牙也。",
      "century": "bce0800",
      "events_count": 8,
      "highlights_count": 6
    },
    {
      "qid": "guji-曹沫",
      "name_zh": "曹沫",
      "era": "春秋初期",
      "archetype": "以勇夺城的义士",
      "role": "模范",
      "birth_date": "约-720",
      "death_date": "不详",
      "summary_first_person": "吾三战三败，失地千里，天下笑吾为败军之将。然吾知勇者不以一败而丧志。柯之盟上，吾以一匕首劫齐桓公于坛上，使归我汶阳之田。管仲纵有万般计谋，亦不敢赌桓公之命。",
      "century": "bce0800",
      "events_count": 3,
      "highlights_count": 1
    },
    {
      "qid": "guji-齐桓公",
      "name_zh": "齐桓公",
      "era": "春秋",
      "archetype": "尊王攘夷的霸业开创者",
      "role": "模范",
      "birth_date": "约-716",
      "death_date": "前643",
      "summary_first_person": "吾兄襄公无道，吾出奔莒。管仲曾射吾带钩，吾几死之。然吾即位后，鲍叔牙荐管仲为相，吾不记前嫌，用之不疑。管仲相齐，通货积财、轻重九府，齐国大富。吾率诸侯北伐山戎、南征楚国，九合诸侯，一匡天下，葵丘会盟，天子赐胙，吾之霸业至于极矣。然管仲既薨，吾用竖刁、易牙、开方三佞，身后五子争立，吾尸六十七日不殡，虫出于户。一世英名，毁于身后。",
      "century": "bce0800",
      "events_count": 8,
      "highlights_count": 6
    },
    {
      "qid": "guji-晋文公",
      "name_zh": "晋文公",
      "era": "春秋",
      "archetype": "流亡十九年终成霸业的坚韧之君",
      "role": "模范",
      "birth_date": "约-697",
      "death_date": "前628",
      "summary_first_person": "吾父献公宠骊姬，吾几死于谗。流亡十九年，过卫绝粮、过曹受辱、过郑被慢。齐桓公妻吾以女，楚成王遇吾以礼。吾许楚王'退避三舍'。及归晋即位，勤王平叛得周襄王赐地。城濮之战，吾践前言退三舍，楚军追击，吾以逸待劳大败之。践土会盟，吾为诸侯之长。然吾一生最痛者，子犯(狐偃)劝吾杀怀公以绝后患，吾终未能与秦穆公善始善终。",
      "century": "bce0700",
      "events_count": 10,
      "highlights_count": 7
    },
    {
      "qid": "guji-秦穆公",
      "name_zh": "秦穆公",
      "era": "春秋",
      "archetype": "称霸西戎的雄略之君",
      "role": "模范",
      "birth_date": "约-682",
      "death_date": "前621",
      "summary_first_person": "吾用百里奚为相，蹇叔为谋，欲东出争霸中原。然崤之战大败于晋，三帅被俘，吾之东进之路断矣。吾不馁，转而西征，灭十二戎国，开地千里，遂霸西戎。吾生平最痛者，不听蹇叔之谏而有崤之败；最憾者，与晋文公联盟终反目。然吾知秦之东出，不在吾世，而在后人。",
      "century": "bce0700",
      "events_count": 8,
      "highlights_count": 6
    },
    {
      "qid": "guji-楚庄王",
      "name_zh": "楚庄王",
      "era": "春秋",
      "archetype": "一鸣惊人的霸业之君",
      "role": "模范",
      "birth_date": "约-613",
      "death_date": "前591",
      "summary_first_person": "吾即位三年，不发号施令，日夜为乐。有谏者杀之。伍举进隐语曰'有鸟止南方之阜，三年不翅不鸣，是何鸟也？'吾曰'此鸟不飞则已，一飞冲天；不鸣则已，一鸣惊人'。遂亲政，诛奸佞，用孙叔敖为相，国大治。问鼎中原，观兵洛郊，晋人畏之。邲之战，大败晋军。吾之霸业，在于忍耐与果决。",
      "century": "bce0700",
      "events_count": 9,
      "highlights_count": 6
    },
    {
      "qid": "Q4604",
      "name_zh": "孔子",
      "era": "春秋",
      "archetype": "奠基型",
      "role": "模范",
      "birth_date": "-551-09-28",
      "death_date": "-479-04-11",
      "summary_first_person": "我周游列国而不得用，归而修诗书——若道不行，便让它在后世行。",
      "century": "bce0600",
      "events_count": 5,
      "highlights_count": 0
    },
    {
      "qid": "guji-孙武",
      "name_zh": "孙武",
      "era": "春秋末期",
      "archetype": "以道驭术的兵家宗师",
      "role": "模范",
      "birth_date": "约-545",
      "death_date": "约-470",
      "summary_first_person": "吾本齐国之后，见齐政日乱，携一卷兵书南奔吴国。阖闾用吾之策，五战五胜，直入郢都。然吴宫之后，世间再无孙武用兵之迹，唯余十三篇兵法，任后人评说。",
      "century": "bce0600",
      "events_count": 6,
      "highlights_count": 3
    },
    {
      "qid": "guji-专诸",
      "name_zh": "专诸",
      "era": "春秋末期",
      "archetype": "一击必杀的义士",
      "role": "模范",
      "birth_date": "约-537",
      "death_date": "-515",
      "summary_first_person": "吾有老母在堂，未敢以身许人。母既终，吾乃无后顾之忧。公子光待吾以国士，吾当以国士报之。鱼藏剑中，一击而中王僚之心，吾虽死无憾。",
      "century": "bce0600",
      "events_count": 4,
      "highlights_count": 2
    },
    {
      "qid": "guji-吴王阖闾",
      "name_zh": "吴王阖闾",
      "era": "春秋末期",
      "archetype": "用贤图强的崛起之君",
      "role": "模范",
      "birth_date": "约-537",
      "death_date": "前496",
      "summary_first_person": "吾弟僚据王位，吾遣专诸刺之于宴席之上，始得即位。伍子胥自楚来奔，为吾策划霸业。孙武以兵法见用，吾拜为将军。吾用此二人，西破强楚，五战入郢，楚昭王仓皇出奔。然越王允常薨，吾伐越时竟被勾践击败，伤指而亡。一生图强，终为他人作嫁。",
      "century": "bce0600",
      "events_count": 7,
      "highlights_count": 4
    },
    {
      "qid": "guji-句践",
      "name_zh": "句践",
      "era": "春秋末期",
      "archetype": "卧薪尝胆的复仇之王",
      "role": "模范",
      "birth_date": "约-520",
      "death_date": "-465",
      "summary_first_person": "吾会稽兵败，为吴王夫差驾车三年，尝粪问疾始得归越。卧薪尝胆二十年，十年生聚十年教训，终灭吴国。吾能忍天下人所不能忍，故能成天下人所不能成。然范蠡知吾，文种不知，终成悲剧。",
      "century": "bce0600",
      "events_count": 7,
      "highlights_count": 5
    },
    {
      "qid": "guji-越王勾践",
      "name_zh": "越王勾践",
      "era": "春秋末期",
      "archetype": "卧薪尝胆的复仇之君",
      "role": "模范",
      "birth_date": "约-520",
      "death_date": "前465",
      "summary_first_person": "吾败于夫椒，困于会稽山，几欲自杀。文种劝吾忍辱求和，吾乃为夫差驾车三年，尝粪问疾以取其信。归国后卧薪尝胆，十年生聚、十年教训。范蠡、文种辅吾灭吴，吾遂称霸中原。然范蠡知吾'可与共患难，不可与共安乐'，辞去泛舟五湖。文种不听，终被吾赐死。吾之一生，从亡国之君到霸主，从忍辱负重到恩将仇报，功过参半。",
      "century": "bce0600",
      "events_count": 9,
      "highlights_count": 7
    },
    {
      "qid": "guji-吴王夫差",
      "name_zh": "吴王夫差",
      "era": "春秋末期",
      "archetype": "胜而骄、骄而亡的悲剧之君",
      "role": "模范",
      "birth_date": "约-510",
      "death_date": "前473",
